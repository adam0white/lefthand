{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lefthand",
  "account_id": "a20259cba74e506296745f9c67c1f3bc",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "lefthand.adamwhite.work",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/engine/*"
    ]
  },
  "main": "worker/index.ts",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
